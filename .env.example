# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_32_plus_random_bytes_hex_string

# ── Asgardeo ─────────────────────────────────────────────────────────────────
# Asgardeo Console → Applications → Create → Mobile Application
# Enable "App-native Authentication API" under the application settings
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/YOUR_ORG_NAME
ASGARDEO_CLIENT_ID=YOUR_CLIENT_ID
# For a public client using PKCE, client secret may not be required.
# If Asgardeo requires a confidential client:
# ASGARDEO_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Registered redirect URI in Asgardeo (must match exactly).
# For the headless App-native flow this is never actually redirected to,
# but it must be registered and sent in the token exchange.
ASGARDEO_REDIRECT_URI=http://localhost:3001/auth/callback

# ── CORS ─────────────────────────────────────────────────────────────────────
# React Native Metro dev server origin (Android emulator / iOS simulator)
CORS_ORIGIN=http://localhost:8081

# ── Mock mode (no Asgardeo tenant yet) ───────────────────────────────────────
# Set to "true" to bypass real Asgardeo calls and return hardcoded user profile.
# Useful for RN development before Asgardeo is configured.
MOCK_AUTH=false
MOCK_EMAIL=demo@example.com
MOCK_DISPLAY_NAME=Demo User
MOCK_CRM_ID=CRM-00000000-0000-0000-0000-000000000000
